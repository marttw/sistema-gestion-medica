// Prisma schema: https://pris.ly/d/prisma-schema
// The connection URL is configured in prisma7.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core schema, v1.7).
// Managed by Better Auth: do not write to these tables directly.
// IDs are generated by Better Auth.
// ---------------------------------------------------------------------------

// A doctor account.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  patients      Patient[]

  @@map("user")
}

// An active login. The browser only holds the session token in a cookie.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// A way to sign in. For email/password, providerId is "credential" and
// `password` stores the scrypt hash (never the plain password).
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// Short-lived tokens (email verification, password reset).
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Patients (administrative data only: no clinical information).
// ---------------------------------------------------------------------------

// A patient always belongs to exactly one doctor (User). Patients are never
// shared: two doctors treating the same person each keep their own record.
model Patient {
  // UUID v7: random but time-ordered, so new rows land at the end of the index.
  id              String   @id @default(uuid(7)) @db.Uuid
  firstName       String
  lastName        String
  // National ID (DNI) stored as text: it is an identifier, not a quantity,
  // and text keeps any leading zeros. Digits only, no dots.
  documentNumber  String
  // Date only (no time, no time zone).
  birthDate       DateTime @db.Date
  phone           String?
  email           String?
  // Health coverage: "obra social" or "prepaga" name and member number.
  healthInsurance String?
  insuranceNumber String?
  doctorId        String
  // Restrict: a doctor with patients cannot be deleted by accident.
  doctor          User     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // The same doctor cannot register the same DNI twice.
  @@unique([doctorId, documentNumber])
  // Matches the list query: filter by doctor, order by last and first name.
  @@index([doctorId, lastName, firstName])
  @@map("patient")
}
