# Copy this file to .env and adjust the values. Never commit .env.
# Development-only values: use your own password, even locally.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medical_app_dev
POSTGRES_PORT=5432

# Prisma connection string (must match the values above)
DATABASE_URL="postgresql://medical_app:change-me@localhost:5432/medical_app_dev?schema=public"

# Better Auth
# Secret used to sign sessions. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Development seed (pnpm db:seed): password for the fictitious doctor account
SEED_DOCTOR_PASSWORD=change-me-too
