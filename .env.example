# Copy this file to .env and adjust the values. Never commit .env.
# Development-only values: use your own password, even locally.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medical_app_dev
POSTGRES_PORT=5432

# Prisma connection string (must match the values above)
DATABASE_URL="postgresql://medical_app:change-me@localhost:5432/medical_app_dev?schema=public"
